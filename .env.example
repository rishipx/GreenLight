# Copy to .env and adjust. Never commit .env.
# APP_ENV=production makes the API refuse to start unless every required secret below is set.

APP_ENV=development

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset for a local SQLite file. Docker Compose provides its own PostgreSQL URL.
# DATABASE_URL=postgresql+psycopg://greenlight:<password>@localhost:5432/greenlight
# Docker Compose only; must be set before the first `docker compose up` creates the volume.
# POSTGRES_PASSWORD=

# --- LLM triage (optional; without a key incidents are recorded with no recommendation) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_REDACTION_ENABLED=true
LLM_REDACT_REQUEST_BODIES=true

# --- Telegram approvals (required in production) ---------------------------------
TELEGRAM_BOT_TOKEN=
# comma-separated numeric Telegram user IDs
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=

# --- API and webhook authentication (required in production; use distinct values) ---
INGEST_API_KEY=
READ_API_KEY=
AGENT_WEBHOOK_SECRET=
ALERTMANAGER_WEBHOOK_SECRET=
GENERIC_WEBHOOK_SECRET=

# --- Remediation -------------------------------------------------------------------
# dry-run | execute
REMEDIATION_MODE=dry-run
REMEDIATION_TIMEOUT_SECONDS=15
APPROVAL_TTL_SECONDS=300
N8N_WEBHOOK_URL=

# --- Request protection ------------------------------------------------------------
MAX_REQUEST_BYTES=65536
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# 0 disables incident de-duplication
DEDUPE_WINDOW_SECONDS=300

# --- Worker ------------------------------------------------------------------------
WORKER_POLL_SECONDS=1.0
# must exceed REMEDIATION_TIMEOUT_SECONDS
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
